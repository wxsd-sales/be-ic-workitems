# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Instant Connect bot token used to create meeting links.
BOT_TOKEN_G2G=your-instant-connect-bot-token

# WxCC Task Routing tokens, one per region.
TASK_ROUTING_TOKEN_US=your-us-routing-token
TASK_ROUTING_TOKEN_EMEA=your-emea-routing-token

# Optional: automatic renewal of the WxCC routing access tokens. Requires the
# service app's client credentials and a refresh token, one set per region
# (each region/tenant has its own service app).
# Without these, the static TASK_ROUTING_TOKEN_* values are used until they expire.
WEBEX_CLIENT_ID_US=your-us-service-app-client-id
WEBEX_CLIENT_SECRET_US=your-us-service-app-client-secret
TASK_ROUTING_REFRESH_TOKEN_US=your-us-refresh-token
WEBEX_CLIENT_ID_EMEA=your-emea-service-app-client-id
WEBEX_CLIENT_SECRET_EMEA=your-emea-service-app-client-secret
TASK_ROUTING_REFRESH_TOKEN_EMEA=your-emea-refresh-token
# WEBEX_TOKEN_URL=https://webexapis.com/v1/access_token

# Optional: persist refreshed tokens in Google Secret Manager (set on Cloud Run).
# Needs one secret per region named ic-work-items-routing-tokens-us / ic-work-items-routing-tokens-emea.
# SECRETS_PROJECT=your-gcp-project-id

# Shared secret for POST /internal/refresh-tokens (called by Cloud Scheduler,
# header X-Cron-Secret). The endpoint is disabled when unset.
# CRON_SECRET=a-long-random-string

# CORS allowlist: comma-separated browser origins (scheme + host + port, no path
# or trailing slash). Defaults to the Live Server origins if unset.
ALLOWED_ORIGINS=https://wazquez.github.io,http://localhost:5500,http://127.0.0.1:5500
